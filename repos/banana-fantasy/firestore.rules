rules_version = '2';

// Firestore security rules for Banana Best Ball.
//
// All reads + writes are denied for client-side callers. Every part of
// the app accesses Firestore via the Admin SDK (server-side, in API
// routes) which bypasses these rules entirely. The browser does NOT
// open a direct Firestore connection — confirmed by codebase grep:
// only `firebase/database` (RTDB) is used client-side, never
// `firebase/firestore`.
//
// Locking this down explicitly closes the historical "test mode"
// default rule that auto-expires (and was a security trap waiting
// to bite — anyone naively renewing the expiration would re-open
// the entire database to the world).
//
// To allow client-side reads in the future, ADD specific match blocks
// rather than relaxing the default. Example pattern:
//
//   match /publicLeaderboards/{id} {
//     allow read: if true;          // anyone can read
//     allow write: if false;        // server-only via Admin SDK
//   }

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
